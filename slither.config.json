{
  "filter_paths": "node_modules|docs|ignition|scripts|test|foundry|contracts/mocks",
  "detectors_to_exclude": "timestamp,reentrancy-events",
  "exclude_dependencies": true,
  "solc_remaps": [
    "@openzeppelin/contracts/=node_modules/@openzeppelin/contracts/",
    "@openzeppelin/contracts-upgradeable/=node_modules/@openzeppelin/contracts-upgradeable/"
  ],
  "solc_args": "--evm-version cancun --optimize --optimize-runs 200"
}
