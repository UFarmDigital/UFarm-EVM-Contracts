{
  "name": "ufarm-evm-contracts-v2",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "build:contract-typings": "node scripts/contract-typings/build-package.mjs",
    "idle": "node -e \"setInterval(() => {}, 2147483647)\"",
    "format": "forge fmt",
    "format:check": "forge fmt --check",
    "test": "hardhat test",
    "test:coverage": "hardhat --coverage test",
    "security:foundry": "forge test --match-path \"foundry/invariant/**/*.t.sol\"",
    "security:slither": "slither . --config-file slither.config.json",
    "security": "npm run security:foundry && npm run security:slither",
    "deploy:foundation": "node --import tsx scripts/deploy-foundation.ts",
    "deploy:quex-batch-oracle": "node --import tsx scripts/deploy-quex-batch-oracle.ts",
    "deploy:private-setup": "node --import tsx scripts/deploy-private-setup.ts",
    "upgrade:foundation": "node --import tsx scripts/upgrade-foundation.ts",
    "verify": "hardhat --network ufarm verify",
    "verify:ignition": "hardhat --network ufarm ignition verify",
    "exec:erc20:approve": "node --import tsx scripts/exec-erc20-approve.ts",
    "exec:any:call": "node --import tsx scripts/exec-any-call.ts",
    "exec:any:permission": "node --import tsx scripts/exec-any-permission.ts",
    "exec:ccip:router": "node --import tsx scripts/exec-ccip-router.ts",
    "exec:core:ccip": "node --import tsx scripts/exec-core-ccip.ts",
    "exec:core:set-value": "node --import tsx scripts/exec-core-set-value.ts",
    "exec:guard:unwhitelist": "node --import tsx scripts/exec-guard-unwhitelist.ts",
    "exec:guard:unwhitelist-eip712": "node --import tsx scripts/exec-guard-unwhitelist-eip712.ts",
    "exec:guard:whitelist": "node --import tsx scripts/exec-guard-whitelist.ts",
    "exec:guard:whitelist-eip712": "node --import tsx scripts/exec-guard-whitelist-eip712.ts",
    "exec:oracle:configure-quex": "node --import tsx scripts/exec-oracle-configure-quex.ts",
    "exec:oracle:configure-quex-batch": "node --import tsx scripts/exec-oracle-configure-quex-batch.ts",
    "exec:quex:submit-response": "node --import tsx scripts/exec-quex-submit-response.ts",
    "exec:core:create-curator": "node --import tsx scripts/exec-core-create-curator.ts",
    "exec:curator:create-vault": "node --import tsx scripts/exec-curator-create-vault.ts",
    "exec:vault:info": "node --import tsx scripts/exec-vault-info.ts",
    "exec:vault:request-deposit": "node --import tsx scripts/exec-vault-request-deposit.ts",
    "exec:vault:request-redeem": "node --import tsx scripts/exec-vault-request-redeem.ts",
    "exec:vault:claim-deposit": "node --import tsx scripts/exec-vault-claim-deposit.ts",
    "exec:vault:claim-redeem": "node --import tsx scripts/exec-vault-claim-redeem.ts",
    "exec:vault:ccip": "node --import tsx scripts/exec-vault-ccip.ts",
    "exec:vault:settle-requests": "node --import tsx scripts/exec-vault-settle-requests.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition-ethers": "3.1.6",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@types/chai": "5.2.3",
    "@types/node": "25.6.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "hardhat": "3.15.0",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "solc": "0.8.35",
    "tsup": "^8.5.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "mocha": {
      "diff": "8.0.3",
      "serialize-javascript": "7.0.5"
    },
    "solc": {
      "tmp": "0.2.7"
    },
    "tsup": {
      "esbuild": "0.28.2"
    }
  }
}
